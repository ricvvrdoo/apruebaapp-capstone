{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "outputDirectory": "public",
  "regions": ["gru1"],
  "functions": {
    "api/index.js": {
      "includeFiles": "node_modules/swagger-ui-dist/**"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ]
}
