# ── Puerto del API ──
PORT=4100

# ── JWT ──
# Con NODE_ENV=production (Vercel) el API no arranca si JWT_SECRET falta, es este
# valor de ejemplo o tiene menos de 32 caracteres. Generar uno sin imprimirlo:
#   node -e "process.stdout.write(require('crypto').randomBytes(48).toString('base64'))" | clip
JWT_SECRET=cambia-esto-en-produccion
JWT_ACCESS_TTL=900          # 15 min (segundos)
JWT_REFRESH_TTL=2592000     # 30 dias (segundos)
JWT_PHONE_TTL=900           # vida del phoneToken tras verificar el SMS

# ── Verificacion telefonica (Firebase Auth phone) ──
# El SMS lo envia el cliente Flutter; el backend valida el idToken resultante
# con las mismas credenciales de Firebase de la seccion Firestore.
# Ojo: el frontend web NO envia phoneToken al registrarse. Para probar el
# registro desde la web, usar PHONE_VERIFICATION_REQUIRED=false.
PHONE_VERIFICATION_REQUIRED=true
# Acepta tokens de prueba "dev:+56912345678" (solo si NODE_ENV != production;
# en un despliegue, usar DEMO_MODE)
PHONE_AUTH_ALLOW_DEV_TOKEN=true
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ── Modo demo (ver src/lib/demo.js) ──
# true habilita atajos de prueba: activar planes sin pago, login social con token
# demo (sin poder entrar a cuentas con contrasena) y tokens de telefono dev:.
# Apagar antes de tener usuarios reales.
DEMO_MODE=false

# ── CORS ──
# El frontend web y la API viven en dominios distintos. Origenes permitidos,
# lista exacta separada por coma. Sin CORS_ORIGINS ni CORS_ORIGIN_REGEX:
# cualquiera en desarrollo y ninguno en produccion. La app movil no envia
# Origin y no pasa por CORS.
# CORS_ORIGINS=https://aprueba-student-web.vercel.app
#
# Patron opcional para los previews del frontend (URL distinta por despliegue).
# Se ancla solo: no hace falta ^ ni $.
# CORS_ORIGIN_REGEX=https://aprueba-student-(web-git-[a-z0-9-]+|[a-z0-9]+)-aprueba\.vercel\.app

# ── Documentacion de la API (/api/docs y /api/v1/openapi.json) ──
# off | protected | public. Sin definir: off en produccion, public en desarrollo.
# protected exige HTTP Basic con estas credenciales; si falta alguna, se cierra.
# API_DOCS=protected
# API_DOCS_USER=
# API_DOCS_PASSWORD=

# ── Banco de preguntas (solo para npm run seed / npm run import:preguntas) ──
# Carpeta que contiene "PAES Chile Verbal", "PAES Chile Matematica", etc.
# Es material de la empresa y NO esta en el repositorio.
# PAES_DIR=C:/ruta/a/la/carpeta/de/la/empresa

# ── Driver de datos ──
# memory   -> almacen en memoria persistido en ./.data/db.json (por defecto, no requiere Firebase)
# firestore-> Cloud Firestore via firebase-admin (requiere credenciales o emulador)
DATA_DRIVER=memory

# ── Firestore (solo si DATA_DRIVER=firestore) ──
# Opcional: si falta, se toma el project_id de la cuenta de servicio.
# GCLOUD_PROJECT=aprueba-app-ad401
#
# Credenciales (usa UNA de estas opciones). La clave NUNCA va en el repositorio:
#
# A) Local: ruta al JSON de la cuenta de servicio, guardado FUERA del repo.
# GOOGLE_APPLICATION_CREDENTIALS=C:/ruta/fuera/del/repo/clave.json
#
# B) Vercel: el contenido del JSON, en texto o en base64, como variable de
#    entorno del proyecto (Settings > Environment Variables), nunca en un archivo.
# FIREBASE_SERVICE_ACCOUNT=
#
# C) Emulador local: sin credenciales.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
