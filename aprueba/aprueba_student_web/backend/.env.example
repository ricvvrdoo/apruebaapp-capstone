# ── Puerto del API ──
PORT=4100

# ── JWT ──
JWT_SECRET=cambia-esto-en-produccion
JWT_ACCESS_TTL=900          # 15 min (segundos)
JWT_REFRESH_TTL=2592000     # 30 dias (segundos)
JWT_PHONE_TTL=900           # vida del phoneToken tras verificar el SMS

# ── Verificacion telefonica (Firebase Auth phone) ──
# El SMS lo envia el cliente Flutter; el backend valida el idToken resultante
# con las mismas credenciales de Firebase de la seccion Firestore.
PHONE_VERIFICATION_REQUIRED=true
# Acepta tokens de prueba "dev:+56912345678" (solo si NODE_ENV != production)
PHONE_AUTH_ALLOW_DEV_TOKEN=true
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ── Banco de preguntas (solo para npm run seed / npm run import:preguntas) ──
# Carpeta que contiene "PAES Chile Verbal", "PAES Chile Matematica", etc.
# Es material de la empresa y NO esta en el repositorio.
# PAES_DIR=C:/ruta/a/la/carpeta/de/la/empresa

# ── Driver de datos ──
# memory   -> almacen en memoria persistido en ./.data/db.json (por defecto, no requiere Firebase)
# firestore-> Cloud Firestore via firebase-admin (requiere credenciales o emulador)
DATA_DRIVER=memory

# ── Firestore (solo si DATA_DRIVER=firestore) ──
# Opcional: si falta, se toma el project_id de la cuenta de servicio.
# GCLOUD_PROJECT=aprueba-app-ad401
#
# Credenciales (usa UNA de estas opciones). La clave NUNCA va en el repositorio:
#
# A) Local: ruta al JSON de la cuenta de servicio, guardado FUERA del repo.
# GOOGLE_APPLICATION_CREDENTIALS=C:/ruta/fuera/del/repo/clave.json
#
# B) Vercel: el contenido del JSON, en texto o en base64, como variable de
#    entorno del proyecto (Settings > Environment Variables), nunca en un archivo.
# FIREBASE_SERVICE_ACCOUNT=
#
# C) Emulador local: sin credenciales.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
