# ── Puerto del API ──
PORT=4100

# ── JWT ──
JWT_SECRET=cambia-esto-en-produccion
JWT_ACCESS_TTL=900          # 15 min (segundos)
JWT_REFRESH_TTL=2592000     # 30 dias (segundos)
JWT_PHONE_TTL=900           # vida del phoneToken tras verificar el SMS

# ── Verificacion telefonica (Firebase Auth phone) ──
# El SMS lo envia el cliente Flutter; el backend valida el idToken resultante.
# En produccion requiere firebase-admin instalado y credenciales.
PHONE_VERIFICATION_REQUIRED=true
# Acepta tokens de prueba "dev:+56912345678" (solo si NODE_ENV != production)
PHONE_AUTH_ALLOW_DEV_TOKEN=true
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ── Driver de datos ──
# memory   -> almacen en memoria persistido en ./.data/db.json (por defecto, no requiere Firebase)
# firestore-> Cloud Firestore via firebase-admin (requiere credenciales o emulador)
DATA_DRIVER=memory

# ── Firestore (solo si DATA_DRIVER=firestore) ──
GCLOUD_PROJECT=aprueba-dev
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
